# Local development only. Copy to .env and replace the placeholder values.
POSTGRES_PASSWORD=replace-with-a-local-development-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=GelyxLabs
JWT_AUDIENCE=GelyxLabs
PORT=8080
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=Replace-with-Local-Admin-Password-123!
AUTH_ALLOW_SELF_REGISTRATION=true

# Email provider configuration. Keep Email__ApiKey and Email__From in environment variables only.
EMAIL__PROVIDER=Logging
EMAIL__APIKEY=
EMAIL__FROM=
EMAIL__SMTPHOST=
EMAIL__SMTPPORT=587
EMAIL__SMTPUSESSL=true
EMAIL__SMTPUSERNAME=
EMAIL__SMTPPASSWORD=

# For Neon deployments, set ConnectionStrings__Default in the hosting provider:
# "Host=<pooled-endpoint>.neon.tech;Database=<database>;Username=<username>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true"
# Use the pooled Neon endpoint for application traffic and the direct endpoint for migrations.
