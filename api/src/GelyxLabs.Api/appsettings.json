{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "App": {
    "Name": "GelyxLabs",
    "DefaultLocale": "es"
  },
  "Auth": {
    "AllowSelfRegistration": false
  },
  "FeatureFlags": {},
  "Jwt": {
    "Issuer": "GelyxLabs",
    "Audience": "GelyxLabs",
    "ExpiryMinutes": 60
  }
}
